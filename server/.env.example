PORT=4000
# Use o connection string do Pooler do Supabase (porta 6543 + ?pgbouncer=true&sslmode=require)
DATABASE_URL=postgresql://postgres.<project-ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require
# Defina como false quando usar o Pooler (Render) para ignorar certificados autoassinados
DATABASE_SSL=false
