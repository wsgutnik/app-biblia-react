PORT=4000
# Use o connection string do Pooler do Supabase (porta 6543 + ?pgbouncer=true&sslmode=require)
DATABASE_URL=postgresql://postgres.<project-ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require
# Alternativa AWS Secrets Manager (quando não quiser expor DATABASE_URL em texto)
DATABASE_SECRET_ARN=arn:aws:secretsmanager:us-east-1:123456789012:secret:seu-segredo
# ou use o nome curto:
DATABASE_SECRET_NAME=seu-segredo
# aliases compatíveis com exemplos da AWS:
AWS_SECRET_NAME=seu-segredo
SECRET_NAME=seu-segredo
AWS_REGION=us-east-1
# opcional, se o segredo não tiver campo dbname:
DATABASE_NAME=postgres
# Defina como false quando usar o Pooler (Render) para ignorar certificados autoassinados
DATABASE_SSL=false
# Stripe (não exponha no frontend)
STRIPE_SECRET_KEY=sk_test_xxx
# Configuração opcional da doação
DONATION_AMOUNT_CENTS=500
DONATION_CURRENCY=usd
DONATION_PRODUCT_NAME=Apoie o projeto Bíblia Sagrada
# URL pública do frontend (usada para redirect quando o header Origin não estiver disponível)
DONATION_SITE_URL=https://seu-frontend.com
